# ============================================================================
#  Temple Social Media App — repo-level infrastructure credentials
#  Copy to .env. Used only by scripts/dokploy.mjs; never shipped to a container.
#  Each service's runtime configuration lives in services/<name>/.env.example.
# ============================================================================

DOKPLOY_URL=https://your-dokploy-host
DOKPLOY_API_KEY=
# Public git URL Dokploy clones from. A public repo needs no GitHub App or key.
# Both applications build from this one repo, at different Dockerfile paths.
DOKPLOY_GIT_URL=https://github.com/you/temple-social-media.git
DOKPLOY_GIT_BRANCH=main

# Application names as they appear in the Dokploy UI.
DOKPLOY_APP_NAME=Social-media-notifications
DOKPLOY_REELS_APP_NAME=Temple-reels
