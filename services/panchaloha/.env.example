# Panchaloha calculator. Copy to .env; .env is gitignored.
PORT=3100

# Basic-auth password for the whole app. Leave empty on your own machine; set
# it anywhere public, because /api/research spends paid API credit.
UI_PASSWORD=

# ---- Rate research providers -------------------------------------------------
# Keys stay on the server and are never sent to the browser. Comma-separate
# several keys to rotate past a rate-limited or rejected one. A provider with
# no key is shown as unavailable; the calculator works without any of them.

# Groq — web search via browser_search on openai/gpt-oss-*, or groq/compound if your org has it.
GROQ_API_KEYS=
GROQ_RESEARCH_MODEL=openai/gpt-oss-120b

# Google Gemini — Google Search grounding.
GEMINI_API_KEYS=
GEMINI_RESEARCH_MODEL=gemini-3.5-flash

# OpenAI — Responses API with the hosted web_search tool.
OPENAI_API_KEYS=
OPENAI_RESEARCH_MODEL=gpt-5

# Anthropic Claude — server-side web search + web fetch tools.
ANTHROPIC_API_KEYS=
ANTHROPIC_RESEARCH_MODEL=claude-opus-5

# groq | gemini | openai | anthropic. Empty = first provider with a key.
RESEARCH_DEFAULT_PROVIDER=
# IN (India, INR) | US (United States, USD)
RESEARCH_DEFAULT_MARKET=IN
RESEARCH_TIMEOUT_SECONDS=240
