{
  "preamble": {
    "dev": [
      "अथ देव्याः कवचम्",
      "ॐ अस्य श्रीचण्डीकवचस्य ब्रह्मा ऋषिः, अनुष्टुप् छन्दः, चामुण्डा देवता,",
      "अङ्गन्यासोक्तमातरो बीजम् दिग्बन्धदेवतास्तत्त्वम्, श्रीजगदम्बाप्रीत्यर्थे | सप्तशतीपाठाङ्गत्वेन जपे विनियोगः ।",
      "॥ ॐ नमश्चण्डिकायै ॥"
    ],
    "eng": [
      "atha devyāḥ kavacam",
      "oṃ asya śrīcaṇḍīkavacasya brahmā ṛṣiḥ, anuṣṭup chandaḥ, cāmuṇḍā devatā,",
      "aṅganyāsoktamātaro bījam digbandhadevatāstattvam, śrījagadambāprītyarthe | saptaśatīpāṭhāṅgatvena jape viniyogaḥ ।",
      "॥ oṃ namaścaṇḍikāyai ॥"
    ]
  },
  "verses": [
    {
      "number": 1,
      "speaker": {
        "dev": "मार्कण्डेय उवाच",
