# services/mantra-tutorials — copy to .env and fill in. Keep in sync with src/config.js.
# Per-service .env (CLAUDE.md §11): this file is pushed only to this app.

# --- web UI ---
PORT=3200
# Basic-auth password for the web UI. Empty = open (fine on localhost; set it in prod).
UI_PASSWORD=

# --- storage ---
# Rendered MP4s + per-mantra caches (Deepgram JSON, slide PNGs). /data in the container.
DATA_DIR=
# Where mantra bundles live (each a folder with a mantra.json). Defaults to ./mantras.
MANTRAS_DIR=

# --- transcription (Deepgram ASR) ---
# Needed only to (re)transcribe. A bundle that ships a deepgram.json cache builds without it.
DEEPGRAM_API_KEY=
DEEPGRAM_LANGUAGE=sa
DEEPGRAM_MODEL=whisper-large

# --- tool binaries (auto-discovered if unset; see src/paths.js) ---
FFMPEG_PATH=
BROWSER_PATH=

# --- video encode (proven defaults; change with care) ---
FPS=30
CROSSFADE_SECONDS=0.7
CRF=19
X264_PRESET=medium
AUDIO_BITRATE=192k

# Optional non-underlined meaning/translation block. Off by default (handover §9.1).
SHOW_MEANING=false

# --- house-style underline defaults (all overridable per mantra and per build) ---
# color: "auto" derives a colour from the background PNG, or a 6-digit hex like #CE7A1F.
UNDERLINE_COLOR=auto
UNDERLINE_THICKNESS_PX=3
UNDERLINE_OPACITY=0.9
# halo=true renders as a softer, thicker single line (this ffmpeg build drives only one drawbox).
UNDERLINE_HALO=false
# motion: glide (eases between words) | step (jumps).
UNDERLINE_MOTION=glide
# target: translit (the reference; default) | dev (underline the Devanagari instead).
UNDERLINE_TARGET=translit
UNDERLINE_GAP_PX=8
UNDERLINE_GLIDE_MS=130
