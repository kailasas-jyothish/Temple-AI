# The root .gitignore already covers node_modules/, data/, .env, *.log and *.mp4.
# This file spells out what stays out of git for a mantra *bundle* specifically,
# so a bundle can hold big local inputs while the small text that defines it is
# committed.

node_modules/
data/
.env
aligner/.venv/
__pycache__/

# Bundle inputs that are large and/or non-redistributable: the chant audio and
# any rendered tutorial. Committed per bundle instead: mantra.json, the
# devanagari/english .md, the deepgram.json cache, background.png and fonts.
mantras/**/*.mp3
mantras/**/*.wav
mantras/**/*.m4a
mantras/**/*.mp4

# Scratch renders dropped next to the code.
*.mp4
.env.deploy
