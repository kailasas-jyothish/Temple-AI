# The root .gitignore already covers node_modules/, data/, .env, *.log and *.mp4.
# Only the service is committed. Mantra bundles (text, backgrounds, audio) are
# content for a particular project and stay on the machine or the /data volume
# that made them, as does the prototype they grew out of.

node_modules/
data/
.env
aligner/.venv/
__pycache__/

mantras/
prototype/

# Scratch renders dropped next to the code.
*.mp4
.env.deploy
