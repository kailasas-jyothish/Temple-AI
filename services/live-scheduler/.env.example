# OAuth client downloaded from Cloud Console -> Google Auth Platform -> Clients.
# Type must be "TVs and Limited Input devices" (sign-in by code). Gitignored.
OAUTH_CLIENT_FILE=./oauth-client.json

# The only channel apply/test/delete will write to. The sign-in belongs to
# whoever approved the code, so this is checked before every write.
# KAILASA's Nithyanandeshwara Paramashiva Devalayam (@kailasastemple)
EXPECTED_CHANNEL_ID=UCgDMywiR2XbZOkYmFknD-mg

# Token, ledgers and generated stream keys. Gitignored.
DATA_DIR=./data
