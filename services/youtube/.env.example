# ============================================================================
#  youtube — configuration
#  The gateway every other service calls for anything that needs youtube.com
#  itself (not the Data API). Copy to services/youtube/.env and fill in.
# ============================================================================

PORT=8090

# Shared secret. Callers send `Authorization: Bearer <GATEWAY_TOKEN>`.
GATEWAY_TOKEN=REPLACE-ME

# Comma-separated CIDRs allowed to call the API port; everything else is
# dropped inside the container. Set it to the temple-ai-internal overlay
# subnet (docker network inspect temple-ai-internal). Loopback always works.
ALLOWED_SOURCES=10.20.0.0/24

# --- VPN ---------------------------------------------------------------------
# YouTube bot-blocks the Dokploy server's own IP, so egress goes through
# WireGuard. The container refuses to start if the tunnel doesn't come up, and
# a kill switch rejects any non-VPN egress while it runs.
VPN_ENABLED=true

# Pick ONE of the three ways to supply the WireGuard config, checked in this
# order.
#
# 1. Field by field (easiest to edit in Dokploy). Values come straight from a
#    wg-quick .conf. Switching VPN location = change WG_ENDPOINT and
#    WG_PEER_PUBLIC_KEY only.
WG_PRIVATE_KEY=
WG_ADDRESS=10.14.0.2/16
WG_DNS=162.252.172.57, 149.154.159.92
WG_PEER_PUBLIC_KEY=
WG_ENDPOINT=nl-ams.prod.surfshark.com:51820
WG_ALLOWED_IPS=0.0.0.0/0
WG_PRESHARED_KEY=
WG_KEEPALIVE=25

# 2. A full wg-quick config, base64-encoded on one line:
#   base64 -w0 nl-ams.conf
WG_CONF_B64=
# 3. A path to a mounted file:
WG_CONF_FILE=

# --- yt-dlp ------------------------------------------------------------------
PLAYER_CLIENTS=web_safari,tv,default
MAX_CONCURRENT=3
# How long a resolved live manifest is reused before asking YouTube again.
MANIFEST_TTL_SECONDS=1200
FFMPEG_TIMEOUT_SECONDS=60
