# ============================================================================
#  notifier — configuration
#  Copy to services/notifier/.env and fill in. Nothing here needs cookies or a
#  browser session. Dokploy credentials live in the repo-root .env, not here.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
PORT=3000
# Public HTTPS URL Dokploy/Traefik serves this app on. Required for enabled
# webhooks (YouTube WebSub and Facebook call back to this URL).
PUBLIC_URL=https://social-notify.example.com
DATA_DIR=/data
LOG_LEVEL=info

# --- Slack -----------------------------------------------------------------
# Slack app -> OAuth & Permissions -> Bot Token Scopes: chat:write, links:read
# Then /invite @YourBot in the target channel.
SLACK_BOT_TOKEN=xoxb-REPLACE-ME
SLACK_CHANNEL_ID=C0C0PGXT46L
# Optional fallback if you'd rather use an Incoming Webhook than a bot token.
SLACK_WEBHOOK_URL=
# Post a "started" message on every boot (useful once, noisy forever).
SLACK_STARTUP_PING=false

# --- YouTube ---------------------------------------------------------------
YOUTUBE_ENABLED=true
# Comma-separated. Each entry is an @handle, a full channel URL, or a raw
# UC... id. Unset means the KAILASA network baked into src/config.js.
YOUTUBE_CHANNELS=@kailasasanjoseus,@KailasaLA,@kailasahouston9302,@kailasaohio7452,@kailasatoronto8217,@KailasaSG,@KAILASATiruvannamalaiSriNithya,@KAILASATiruvannamalai-NJBK,@SriNithyanandaJanmabumiSthalam,@kailasainhyderabadsripuram3448,@KAILASATanjavur,@KAILASAKothapet-Hyderabad,@kailasaindubai,@kailasauganda,@kailasasjp
# Required when YouTube is enabled.
# console.cloud.google.com -> enable "YouTube Data API v3" -> create API key.
YOUTUBE_API_KEY=
# Shared secret for the WebSub HMAC. Any random string; keep it stable.
YOUTUBE_WEBSUB_SECRET=CHANGE-ME
YOUTUBE_WEBSUB_ENABLED=false
YOUTUBE_LIVE_POLL_SECONDS=20
# One channel is checked per tick, round-robin, so this is NOT the per-channel
# interval — that is this value x the number of channels (6 x 30s = 3 min).
# Quota is 86400/uploads + 86400/live units/day and the free ceiling is 10,000,
# so lowering either of these is what to check first if the API starts 403ing.
YOUTUBE_UPLOADS_POLL_SECONDS=30
# A finished video older than this is recorded but never posted — discovery
# reads the newest 50 uploads, so without it any gap in the dedupe store (wiped
# volume, pruned keys, a channel seeded from a smaller window) would replay the
# back catalogue into Slack. Live and upcoming streams are exempt.
YOUTUBE_MAX_AGE_HOURS=24
# true adds a second card when a stream is *scheduled*, on top of the one at
# go-live. Off by default: one notification per stream.
YOUTUBE_NOTIFY_UPCOMING=false

# --- Attendance sheet (24/7 Garbha Mandir live streams) --------------------
ATTENDANCE_ENABLED=true
# The "2.0 Global Temples Attendance" spreadsheet id, from its URL.
ATTENDANCE_SPREADSHEET_ID=
ATTENDANCE_TAB=24x7-Live-Stream-Monitoring
# Which channel is which temple row, and in which timezone. Committed, no
# secrets — edit it when a channel is added to YOUTUBE_CHANNELS.
ATTENDANCE_TEMPLES_FILE=./temples.json
# Rolls the day's column, re-credits still-running streams and drains the retry
# queue. Costs one YouTube quota unit per sweep.
ATTENDANCE_SWEEP_SECONDS=600
# A 24/7 stream fires one live event and then runs for days; it keeps counting
# for this long before the temple is expected to restart the broadcast.
ATTENDANCE_CONTINUATION_HOURS=48
ATTENDANCE_NOTIFY_SLACK=true
ATTENDANCE_ALERT_AFTER_ATTEMPTS=3
# Best-effort first-frame grab via yt-dlp + ffmpeg. Leave FALSE on the Dokploy
# host: youtube.com answers that datacenter IP with "Sign in to confirm you're
# not a bot", and yt-dlp's only remedy is cookies, which this project does not
# do. It works from a residential IP. The fallback is YouTube's own thumbnail,
# which for a 24/7 broadcast is an auto-generated frame of that stream.
ATTENDANCE_SNAPSHOT_ENABLED=false
ATTENDANCE_SNAPSHOT_TIMEOUT_SECONDS=45
# Where Google's servers can fetch the captured frames from, for =IMAGE().
# Falls back to PUBLIC_URL. Without either, the sheet shows thumbnails instead.
ATTENDANCE_SNAPSHOT_BASE_URL=

# --- Google service account (writes the attendance sheet) ------------------
# Cloud Console -> enable "Google Sheets API" -> Credentials -> Service account
# -> Keys -> JSON. Then share the sheet with the key's client_email as Editor.
# In the container this is the base64 of that JSON file (one line):
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# Local development reads the file directly instead. Gitignored.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# --- Facebook (official Graph API — needs Page admin + a free Meta app) -----
# Leave FACEBOOK_ENABLED=false until you have a Page access token.
FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=CHANGE-ME
FACEBOOK_GRAPH_VERSION=v21.0
FACEBOOK_POLL_ENABLED=true
FACEBOOK_POLL_SECONDS=60

# --- Generic ingest --------------------------------------------------------
# Comma-separated tokens accepted by POST /ingest. Lets Make/Zapier/IFTTT (or
# any script) push an event into the same Slack pipeline.
INGEST_TOKENS=

# --- Admin -----------------------------------------------------------------
# Protects GET /status, GET /admin/recent, POST /admin/test, and resubscribe.
ADMIN_TOKEN=CHANGE-ME
