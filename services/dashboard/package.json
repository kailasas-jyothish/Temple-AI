{
  "name": "temple-ai-dashboard",
  "version": "1.0.0",
  "description": "One page for every Temple AI service: links, live health and the numbers each service reports.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:local": "node --env-file=.env src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run typecheck && npm test",
    "dokploy": "node ../../scripts/dokploy.mjs --app dashboard"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
