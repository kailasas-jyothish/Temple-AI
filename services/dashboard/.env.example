# Temple AI dashboard. Copy to .env; .env is gitignored.
PORT=3300

# Basic-auth password for the whole page. Leave empty on your own machine; set
# it anywhere public, because the page shows admin-only numbers.
UI_PASSWORD=

# Where the "Open" buttons send the browser. Each service is <host>:<port>.
PUBLIC_HOST=http://157.180.15.165
# Where the dashboard itself probes from. Defaults to PUBLIC_HOST; set it to
# http://localhost for a local run against locally running services.
PROBE_HOST=

# Per-service probe URL, overriding PROBE_HOST:<port>. Required on Dokploy: a
# container cannot reach its own host's public IP, so probe each service by its
# Swarm service name and container port over dokploy-network.
# (`node scripts/dokploy.mjs show --app <name>` prints the swarm name.)
PROBE_URL_NOTIFIER=
PROBE_URL_REELS=
PROBE_URL_MANTRA_TUTORIALS=
PROBE_URL_PANCHALOHA=
PROBE_URL_SCRIPTURES=
PROBE_URL_FESTIVAL_BUDGET=

PROBE_INTERVAL_SECONDS=30
PROBE_TIMEOUT_SECONDS=8

# The notifier's ADMIN_TOKEN (services/notifier/.env). Unlocks channel counts,
# scheduled streams and today's live Garbha Mandir temples on its card.
NOTIFIER_ADMIN_TOKEN=

# The gateway: /<service-id>/ on this page forwards to that service (by its
# PROBE_URL_* above), after the dashboard's own login. Each service's own
# credential is injected here so one password opens everything. Copy each from
# that service's .env / .env.deploy (UI_PASSWORD; reels uses ADMIN_TOKEN). The
# notifier reuses NOTIFIER_ADMIN_TOKEN.
UPSTREAM_PASSWORD_MANTRA_TUTORIALS=
UPSTREAM_PASSWORD_SCRIPTURES=
UPSTREAM_PASSWORD_FESTIVAL_BUDGET=
UPSTREAM_PASSWORD_PANCHALOHA=
UPSTREAM_TOKEN_REELS=

# HTTPS listener (container port) for https://temple.unclutch.dev:8443. The
# image sets TLS_PORT=3443 and bakes a self-signed cert; leave empty locally.
# TLS_CERT_PEM_B64 / TLS_KEY_PEM_B64 replace the cert (e.g. Cloudflare Origin CA).
TLS_PORT=
TLS_CERT_PEM_B64=
TLS_KEY_PEM_B64=
