# Temple Festival Budget. Copy to .env; .env is gitignored.
PORT=8000

# Basic-auth password for the web UI (any username). Leave empty on your own
# machine; set it on the host, where the page is plain HTTP on a public IP.
UI_PASSWORD=

# Where the library and budgets live. Locally the festival-budget.cmd wrapper points this at ./data.
DATA_DIR=/data

# The Google service account that writes the sheets. Locally, the path to its
# JSON key (keep it OUTSIDE the repo). On the host, the same file base64-encoded
# into one line, since a PEM key cannot be a single .env value otherwise.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# A folder inside a Shared Drive where new budget spreadsheets are created. The
# service account has no storage of its own, so it cannot create a sheet in
# My Drive; it must be a member (Content manager) of the Shared Drive. Leave
# empty to always write into an existing spreadsheet link shared with it as editor.
BUDGET_FOLDER_ID=
