{
  "name": "temple-scriptures",
  "version": "0.1.0",
  "private": true,
  "description": "Upanishads from sanskritdocuments.org as Devanagari + IAST, translated through OpenRouter, one CSV per text.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:local": "node --env-file-if-exists=.env src/index.js",
    "cli": "node --env-file-if-exists=.env src/cli.js",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run typecheck && npm test",
    "corpus": "node --env-file-if-exists=.env scripts/corpus.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
