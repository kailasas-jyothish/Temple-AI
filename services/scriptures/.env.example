PORT=3400
# Basic-auth password for the UI and API (any username). Required anywhere public.
UI_PASSWORD=
# Where sources, translations cache, jobs and out/<id>.csv live. Default: ./data
DATA_DIR=

OPENROUTER_API_KEY=
# Leave empty until a model is chosen with `compare`; translation refuses to run without one.
TRANSLATION_MODEL=
# prompts/<name>.md
TRANSLATION_PROMPT=sph-v1
TRANSLATION_TEMPERATURE=0.2
# Earlier passages (with their translations) sent as context
TRANSLATION_CONTEXT_VERSES=2
# A translate run stops once it has spent this much (USD). 0 = no limit.
MAX_COST_USD=5
TRANSLATION_TIMEOUT_SECONDS=180
OPENROUTER_APP_TITLE=Temple AI scriptures

# Pause between requests to sanskritdocuments.org (volunteer-run; be polite)
FETCH_DELAY_MS=1000
SOURCE_BASE_URL=https://sanskritdocuments.org
SOURCE_CATALOG_PATH=/doc_upanishhat/
