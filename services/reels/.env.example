# ============================================================================
#  reels — configuration
#  Copy to services/reels/.env and fill in. Dokploy credentials live in the
#  repo-root .env, not here.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
PORT=8000
# Public URL Dokploy serves this app on. Used for the link in Slack cards and
# to decide whether the session cookie is marked Secure.
PUBLIC_URL=
DATA_DIR=/data
LOG_LEVEL=info
# Shared password for the web UI. The app writes into the temple Drive, so this
# is not optional.
APP_PASSWORD=CHANGE-ME
# Optional: lets a script drive the API with an x-admin-token header instead.
ADMIN_TOKEN=

# --- Google Drive ----------------------------------------------------------
# OAuth client from console.cloud.google.com -> APIs & Services -> Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produced once by `python scripts/authorize.py` on your own machine.
# IMPORTANT: Google expires refresh tokens from an app whose OAuth consent
# screen is still in "Testing" after exactly 7 days. Set the consent screen to
# Internal, or publish it to Production, before generating this.
GOOGLE_REFRESH_TOKEN=
# The "Vision Pics" folder — a raw id or the full Drive link.
DRIVE_ROOT_FOLDER_ID=
DRIVE_SONGS_FOLDER_NAME=Songs
DRIVE_ELEMENTS_FOLDER_NAME=Elements
DRIVE_REELS_FOLDER_NAME=Reels
# Give the uploaded reel a "anyone with the link" permission.
DRIVE_SHARE_REEL=false

# --- Branding --------------------------------------------------------------
# Optional overrides. Each accepts a raw file id or a full Drive link, and beats
# the name lookup in the Elements folder. The UI writes the same values without
# needing a redeploy.
LOGO_FILE_ID=
ENDCARD_FILE_ID=
INTRO_FILE_ID=
# The caption scrim (Overlay-gradient.png) and the caption face
# (Mart-DevanagariBold.otf). Both are found by name in Elements; set these only
# to pin a specific file. A font must be .otf or .ttf — ffmpeg reads both.
GRADIENT_FILE_ID=
CAPTION_FONT_FILE_ID=
# auto reads the file's shape: an overlay cut to the output aspect (the real
# ReelsFrame_2025_Copyright.png is 1080x1920) is laid over the whole frame,
# anything else is scaled to LOGO_HEIGHT and tucked into LOGO_POSITION.
LOGO_MODE=auto
LOGO_POSITION=top-right
LOGO_HEIGHT=110
LOGO_MARGIN=48
LOGO_OPACITY=1.0
ENDCARD_SECONDS=3
INTRO_SECONDS=2.5

# --- Video clips -----------------------------------------------------------
# Clips in the temple folders are used alongside the photographs. A clip is not
# a candidate; its steady *windows* are, and each carries a still, so the
# prefilter, the duplicate check and the model all judge it exactly as they
# judge a photograph. A clip fills one shot slot, so the reel length is
# unchanged by how many get picked.
INCLUDE_VIDEOS=true
# Decided from the Drive listing, before anything is downloaded.
VIDEO_MAX_CLIPS=24
VIDEO_MAX_SIZE_MB=400
# At most this share of the reel may be clips, so one long video cannot become
# the whole thing however well its windows score.
VIDEO_SHARE=0.5
VIDEO_SEGMENTS_PER_CLIP=2
VIDEO_MIN_GAP_SECONDS=1.0
# How far the 9:16 crop may stretch a clip: max(1080/w, 1920/h). Neither
# MIN_IMAGE_PX nor a plain height is the right test — most of the archive is
# WhatsApp video at 480x848, whose height passes any height rule while its
# width is what actually gets upscaled. Measured on the real folders:
# 1080x1920 1.0, 2160x3840 0.5, 720x1280 1.5, 1920x1080 1.78, 480x848 2.26,
# then a cliff to 848x480 and 640x480 at 4.0. Lower this for a crisper reel
# with fewer clips in it.
VIDEO_MAX_UPSCALE=2.5
# Shake is the mean change in frame velocity across a window, as a percentage
# of frame height per analysis step. Measured on synthesised camera moves:
# locked off 0.0, smooth pan 0.26, gentle handheld 0.29, brisk walking 3.3,
# shaky 25, violent 39. Raise to keep more handheld footage, lower for stricter.
VIDEO_SHAKE_THRESHOLD=1.6
VIDEO_SHAKE_PEAK=6.0
VIDEO_MIN_SHARPNESS=25
# Must stay above ~12/s. Handheld jitter is 2-6Hz, and at 5/s the sampling
# aliased it — a 4.5Hz shake folded to 0.5Hz and measured as *smoother* than a
# gentle walk, ranking the calibration clips in the wrong order entirely.
VIDEO_ANALYSIS_FPS=15
VIDEO_WINDOW_HOP_SECONDS=0.6
VIDEO_MAX_ANALYSIS_SECONDS=120
VIDEO_WORKERS=3

# --- Caption ---------------------------------------------------------------
# The text itself is asked for per run (CLI prompt, --caption, or the UI field).
# With no text neither the scrim nor the type is drawn at all. Both appear over
# the photographs only, so the intro and end cards stay as they were designed.
CAPTION_COLOR=white
# A ceiling: a long caption wraps and shrinks towards CAPTION_MIN_FONT_SIZE
# rather than running off the frame.
CAPTION_FONT_SIZE=76
CAPTION_MIN_FONT_SIZE=44
CAPTION_MAX_LINES=3
# The copyright frame's own text occupies rows 1722-1822 of 1920, so the last
# caption line stops 260px above the base and leaves a clear band between them.
CAPTION_BOTTOM_MARGIN=260
CAPTION_SIDE_MARGIN=90
CAPTION_LINE_SPACING=18
CAPTION_FADE_SECONDS=0.5

# --- Image selection (the LLM's only job) ----------------------------------
# Which provider scores first, and which covers for it. A batch that fails on
# both keeps its prefilter score rather than failing the job.
CURATION_PROVIDER=groq
CURATION_FALLBACK_PROVIDER=gemini
# false skips the models entirely and selects on sharpness alone.
CURATION_ENABLED=true

# Comma-separated; a rate-limited key rotates to the next one.
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.8-27b
# This model accepts 3 images per request. Check /v1/models before raising it —
# the vision models a given account can reach are not the same everywhere.
GROQ_BATCH_SIZE=3
GROQ_TIMEOUT_SECONDS=90

GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BATCH_SIZE=4
GEMINI_TIMEOUT_SECONDS=90

# Local triage that runs before any token is spent.
# The ceiling on images sent to the model. The pool actually used is sized from
# the reel length (CANDIDATES_PER_SHOT per shot), because scoring is the slowest
# stage and a short reel has no use for a deep pool.
MAX_CANDIDATES=120
CANDIDATES_PER_SHOT=3
# Photographs fetched from Drive before triage, capped again at 5x the pool.
DOWNLOAD_CAP=400
# Batches are scored concurrently, and the whole stage gives up after the budget
# and keeps heuristic scores for whatever is left, so a run always finishes.
CURATION_WORKERS=4
CURATION_BUDGET_SECONDS=300
PREFILTER_WORKERS=8
MIN_IMAGE_PX=1000
BLUR_THRESHOLD=40
DHASH_DISTANCE=5
# Every temple that turned up gets at least this many shots, before anything is
# allocated on merit.
MIN_PER_TEMPLE=2

# --- Render (ffmpeg's job — the LLM never touches any of this) --------------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
TARGET_DURATION_SECONDS=60
SECONDS_PER_IMAGE=3.2
# Must be smaller than SECONDS_PER_IMAGE: each xfade eats the tail of one shot
# and the head of the next.
TRANSITION_SECONDS=0.5
# 0 derives the shot count from TARGET_DURATION_SECONDS.
SHOT_COUNT=0
# auto finds the loudest sustained passage of the song — the chorus, in practice
# — instead of opening on whatever the first seconds happen to be, which for a
# devotional recording is usually silence and a slow intro. Set to "start" for
# the old behaviour; --song-start overrides either, per run.
MUSIC_PICK=auto
# ffmpeg is killed past this, so a stalled graph fails with a reason instead of
# holding the one render worker for ever.
RENDER_TIMEOUT_SECONDS=1800
RENDER_CRF=20
RENDER_PRESET=medium
RENDER_AUDIO_BITRATE=192k
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Slack -----------------------------------------------------------------
# A separate app and channel from the notifier's. Bot scopes: chat:write, and
# files:write only if SLACK_UPLOAD_POSTER is on. Then /invite the bot.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_UPLOAD_POSTER=false
